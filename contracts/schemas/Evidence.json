{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "sourceType": {
      "enum": [
        "curated",
        "provider",
        "user"
      ],
      "title": "Sourcetype",
      "type": "string"
    },
    "sourceRef": {
      "anyOf": [
        {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Sourceref"
    },
    "checkedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Checkedat"
    },
    "status": {
      "enum": [
        "checked",
        "estimated",
        "unverified"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "sourceType",
    "sourceRef",
    "checkedAt",
    "status"
  ],
  "title": "Evidence",
  "type": "object"
}
