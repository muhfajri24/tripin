{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
      "title": "Code",
      "type": "string"
    },
    "dayIndex": {
      "anyOf": [
        {
          "maximum": 2,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Dayindex"
    },
    "stopIds": {
      "items": {
        "maxLength": 100,
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
        "type": "string"
      },
      "title": "Stopids",
      "type": "array"
    },
    "message": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    }
  },
  "required": [
    "code",
    "dayIndex",
    "stopIds",
    "message"
  ],
  "title": "Violation",
  "type": "object"
}
